  address     = {Incheon, Korea},
  publisher   = {IEEE},
  abstract    = {Defines four anomaly types in a multi-robot system (battery depletion, unexpected obstacle, trajectory conflict, collision risk within 0.2 m), detects them in a module decoupled from RMF task allocation, and visualizes them in real time on a WebSocket/ROS-bridge web dashboard. Validated in a Gazebo simulation with 30 mobile robots.},
