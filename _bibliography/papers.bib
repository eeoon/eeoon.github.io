@inproceedings{kim2024traversability,
  abbr        = {ICCAS},
  bibtex_show = {true},
  selected    = {true},
  title       = {Traversability Assessment and Path Planning Using Obstacle Recognition Information for Multi-Robot System},
  author      = {Kim, YoungEon and Kim, Dong Yeop and Kim, Keunhwan},
  booktitle   = {2024 24th International Conference on Control, Automation and Systems (ICCAS)},
  year        = {2024},
  month       = {October},
  pages       = {1670--1671},
  address     = {Jeju, Korea},
  publisher   = {IEEE},
  abstract    = {Each robot detects dynamic obstacles (people) with an RGB-D camera and YOLOv8 and shares them with the RMF server. When the number of obstacles adjacent to a graph edge exceeds a predefined threshold, the edge is deactivated and affected robots proactively re-plan. Experiments with four robots show reduced collision risk and path cost compared with a non-cooperative system.},
  preview     = {traversability-assessment-path-planning.png},
  annotation  = {First author},
  award       = {1st author},
  award_name  = {1st author}
}

@inproceedings{kim2024crossutilization,
  abbr        = {ICROS},
  bibtex_show = {true},
  selected    = {true},
  title       = {Method for Cross-Utilization of Obstacle Recognition Information in a Multi-Robot System for Collaborative Path Planning},
  author      = {Kim, Youngeon and Kim, Keunhwan and Kim, Dong Yeop},
  booktitle   = {Conference of the Institute of Control, Robotics and Systems (ICROS 2024)},
  year        = {2024},
  month       = {July},
  address     = {Daejeon, Korea},
  abstract    = {Obstacles detected by each mobile robot with a 2D LiDAR and an RGB-D camera (YOLOv8) are transformed into the global map frame and shared so that other robots can use them for collaborative path planning. In the Open-RMF fleet manager, lanes are marked active or inactive from the shared obstacle information so that robots only travel on active lanes. Validated in Gazebo with two robots.},
  preview     = {cooperative-path-planning-obstacle-info.png},
  annotation  = {First author, presenter},
  award       = {1st author},
  award_name  = {1st author}
}

