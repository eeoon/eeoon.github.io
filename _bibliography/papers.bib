  abbr        = {ICCAS},
  bibtex_show = {true},
  selected    = {true},
  title       = {Anomaly Detection and Visualization Framework for Multi-Robot Systems Using RMF},
  author      = {Kim, Youngeon and Jung, Yohan and Kim, Dong Yeop and Kim, Keunhwan},
