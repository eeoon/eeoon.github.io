  abbr        = {ICROS},
  bibtex_show = {true},
  selected    = {true},
  title       = {A Learning-based Anomaly Detection Framework for Multi-Robot Systems},
  author      = {Kim, Youngeon and Jung, Yohan and Kim, Dong Yeop and Kim, Keunhwan},
  booktitle   = {Conference of the Institute of Control, Robotics and Systems (ICROS 2026)},
  year        = {2026},
  month       = {July},
  address     = {Daegu, Korea},
  abstract    = {In an Open-RMF simulation with ten mobile robots, position error, velocity, battery level and mission progress are defined as time-series features, and a Transformer-based self-supervised model (RESTAD) learns spatio-temporal correlations across robots to detect anomalies without labels. On the region-level metric (Aff-F1 0.94) it outperforms LSTM and a plain Transformer. Learning-based follow-up to the rule-based ICCAS 2025 framework.},
  preview     = {learning-anomaly-detection-framework.png},
  annotation  = {First author, presenter},
  award       = {1st author},
  award_name  = {1st author}
}

